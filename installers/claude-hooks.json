{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "{{DAEMON_URL}}/events/claude/session-start",
          "headers": {
            "X-Agent-Island-Token": "{{TOKEN}}",
            "X-Term-Program": "$TERM_PROGRAM",
            "X-Iterm-Session-Id": "$ITERM_SESSION_ID",
            "X-Term-Session-Id": "$TERM_SESSION_ID"
          },
          "allowedEnvVars": ["TERM_PROGRAM", "ITERM_SESSION_ID", "TERM_SESSION_ID"],
          "timeout": 5
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "http",
          "url": "{{DAEMON_URL}}/events/claude/pre-tool",
          "headers": {
            "X-Agent-Island-Token": "{{TOKEN}}",
            "X-Term-Program": "$TERM_PROGRAM",
            "X-Iterm-Session-Id": "$ITERM_SESSION_ID",
            "X-Term-Session-Id": "$TERM_SESSION_ID"
          },
          "allowedEnvVars": ["TERM_PROGRAM", "ITERM_SESSION_ID", "TERM_SESSION_ID"],
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "http",
          "url": "{{DAEMON_URL}}/events/claude/post-tool",
          "headers": {
            "X-Agent-Island-Token": "{{TOKEN}}",
            "X-Term-Program": "$TERM_PROGRAM",
            "X-Iterm-Session-Id": "$ITERM_SESSION_ID",
            "X-Term-Session-Id": "$TERM_SESSION_ID"
          },
          "allowedEnvVars": ["TERM_PROGRAM", "ITERM_SESSION_ID", "TERM_SESSION_ID"],
          "timeout": 5
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "http",
          "url": "{{DAEMON_URL}}/events/claude/permission-request",
          "headers": {
            "X-Agent-Island-Token": "{{TOKEN}}",
            "X-Term-Program": "$TERM_PROGRAM",
            "X-Iterm-Session-Id": "$ITERM_SESSION_ID",
            "X-Term-Session-Id": "$TERM_SESSION_ID"
          },
          "allowedEnvVars": ["TERM_PROGRAM", "ITERM_SESSION_ID", "TERM_SESSION_ID"],
          "timeout": 5
        }
      ]
    }
  ],
  "Notification": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "{{DAEMON_URL}}/events/claude/notification",
          "headers": {
            "X-Agent-Island-Token": "{{TOKEN}}",
            "X-Term-Program": "$TERM_PROGRAM",
            "X-Iterm-Session-Id": "$ITERM_SESSION_ID",
            "X-Term-Session-Id": "$TERM_SESSION_ID"
          },
          "allowedEnvVars": ["TERM_PROGRAM", "ITERM_SESSION_ID", "TERM_SESSION_ID"],
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "{{DAEMON_URL}}/events/claude/stop",
          "headers": {
            "X-Agent-Island-Token": "{{TOKEN}}",
            "X-Term-Program": "$TERM_PROGRAM",
            "X-Iterm-Session-Id": "$ITERM_SESSION_ID",
            "X-Term-Session-Id": "$TERM_SESSION_ID"
          },
          "allowedEnvVars": ["TERM_PROGRAM", "ITERM_SESSION_ID", "TERM_SESSION_ID"],
          "timeout": 5
        }
      ]
    }
  ]
}
