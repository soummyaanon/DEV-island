<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened runtime (Developer ID builds only). Native code, so none of
         Electron's JIT exceptions. Voice mode: the runtime blocks the mic without this. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Jump back: bringing the agent's terminal tab forward over Apple Events. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Quick controls: the Bluetooth radio and paired devices. -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- Today: calendar events and reminders, read on this Mac once allowed. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
  </dict>
</plist>
